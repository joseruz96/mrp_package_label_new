<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_mrp_production_form_new_package_label" model="ir.ui.view">
        <field name="name">mrp.production.form.new.package.label</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="priority" eval="90"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="button_generate_label_new"
                        string="Imprimir etiqueta nueva"
                        type="object"
                        class="btn-secondary"
                        icon="fa-barcode"
                        groups="stock.group_stock_user"
                        attrs="{'invisible': [('state', 'in', ['draft', 'cancel'])]}"/>
            </xpath>
        </field>
    </record>
    <record id="view_mrp_production_hide_legacy_label" model="ir.ui.view">
        <field name="name">mrp.production.hide.legacy.label</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp_report_tag.view_mrp_production_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_generate_label']" position="attributes">
                <attribute name="invisible">1</attribute>
                <attribute name="attrs">{}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
